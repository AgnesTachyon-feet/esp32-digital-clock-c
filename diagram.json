
{
  "version": 1,
  "author": "ESP-IDF Digital Clock Lab",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-ds1307",
      "id": "rtc",
      "top": -200,
      "left": 320,
      "attrs": {
        "initTime": "now"
      }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -30,
      "left": 330,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "mode",
      "top": 260,
      "left": -220,
      "attrs": {
        "color": "red",
        "label": "MODE"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "set",
      "top": 260,
      "left": -90,
      "attrs": {
        "color": "green",
        "label": "SET"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "alarm",
      "top": 260,
      "left": 40,
      "attrs": {
        "color": "yellow",
        "label": "ALARM"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "lap",
      "top": 260,
      "left": 170,
      "attrs": {
        "color": "blue",
        "label": "LAP"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": -190,
      "left": -150,
      "attrs": {
        "volume": "0.15"
      }
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["esp:5V", "rtc:5V", "red", []],
    ["esp:GND.1", "rtc:GND", "black", []],
    ["esp:21", "rtc:SDA", "green", []],
    ["esp:22", "rtc:SCL", "blue", []],

    ["esp:3V3", "oled:VCC", "red", []],
    ["esp:GND.1", "oled:GND", "black", []],
    ["esp:21", "oled:SDA", "green", []],
    ["esp:22", "oled:SCL", "blue", []],

    ["esp:18", "mode:1.l", "green", []],
    ["esp:GND.1", "mode:2.l", "black", []],

    ["esp:19", "set:1.l", "green", []],
    ["esp:GND.1", "set:2.l", "black", []],

    ["esp:4", "alarm:1.l", "green", []],
    ["esp:GND.1", "alarm:2.l", "black", []],

    ["esp:5", "lap:1.l", "green", []],
    ["esp:GND.1", "lap:2.l", "black", []],

    ["esp:25", "buzzer:2", "orange", []],
    ["esp:GND.1", "buzzer:1", "black", []]
  ],
  "dependencies": {}
}
